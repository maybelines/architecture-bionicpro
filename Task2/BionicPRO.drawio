  <diagram id="reports" name="Сервис отчётов">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;BionicPRO — подготовка и получение отчётов&lt;/b&gt;&lt;br&gt;C4: контейнеры, участвующие в отчётности" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=24;">
          <mxGeometry as="geometry" x="290" y="20" width="1500" height="70" />
        </mxCell>
        <mxCell id="country" value="&lt;b&gt;BionicPRO / страна присутствия&lt;/b&gt;&lt;br&gt;Все источники и отчёты хранятся в этой стране" parent="1" vertex="1" style="rounded=0;html=1;whiteSpace=wrap;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;spacing=15;fontSize=15;">
          <mxGeometry as="geometry" x="270" y="110" width="1690" height="1230" />
        </mxCell>
        <mxCell id="user" value="&lt;b&gt;Пилот протеза&lt;/b&gt;&lt;br&gt;[Person]" parent="1" vertex="1" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#6C6477;strokeColor=#4D4D4D;fontColor=#ffffff;fontSize=16;">
          <mxGeometry as="geometry" x="20" y="190" width="190" height="175" />
        </mxCell>
        <mxCell id="frontend" value="&lt;b style=&quot;font-size:18px&quot;&gt;Приложение отчётов&lt;/b&gt;&lt;br&gt;[Container: React / TypeScript]&lt;br&gt;&lt;br&gt;Выбор периода,&lt;br&gt;просмотр и скачивание отчёта" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=15;spacing=12;">
          <mxGeometry as="geometry" x="340" y="230" width="270" height="145" />
        </mxCell>
        <mxCell id="api" value="&lt;b style=&quot;font-size:18px&quot;&gt;API / сервис отчётов&lt;/b&gt;&lt;br&gt;[Container: Python / FastAPI]&lt;br&gt;&lt;br&gt;GET /reports&lt;br&gt;Проверка JWT и готовности периода.&lt;br&gt;Пользователь из sub" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=15;spacing=12;">
          <mxGeometry as="geometry" x="930" y="230" width="270" height="175" />
        </mxCell>
        <mxCell id="keycloak" value="&lt;b style=&quot;font-size:18px&quot;&gt;Keycloak&lt;/b&gt;&lt;br&gt;[Container: Keycloak]&lt;br&gt;&lt;br&gt;Вход с PKCE S256.&lt;br&gt;Выдача JWT для reports-api" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=15;spacing=12;">
          <mxGeometry as="geometry" x="640" y="490" width="270" height="145" />
        </mxCell>
        <mxCell id="olap" value="&lt;b style=&quot;font-size:18px&quot;&gt;OLAP&lt;/b&gt;&lt;br&gt;[Container: ClickHouse]&lt;br&gt;&lt;br&gt;CRM + телеметрия&lt;br&gt;daily_reports: готовая витрина&lt;br&gt;completed_days: готовые дни" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=15;spacing=12;shape=cylinder3;size=16;boundedLbl=1;">
          <mxGeometry as="geometry" x="1510" y="230" width="350" height="200" />
        </mxCell>
        <mxCell id="crm" value="&lt;b style=&quot;font-size:18px&quot;&gt;CRM&lt;/b&gt;&lt;br&gt;[Container: Битрикс24]&lt;br&gt;&lt;br&gt;Клиенты и их протезы" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=15;spacing=12;">
          <mxGeometry as="geometry" x="340" y="800" width="270" height="145" />
        </mxCell>
        <mxCell id="crm-db" value="&lt;b style=&quot;font-size:18px&quot;&gt;CRM DB&lt;/b&gt;&lt;br&gt;[Container: База CRM]&lt;br&gt;&lt;br&gt;user_id, имя,&lt;br&gt;протез и модель" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=15;spacing=12;shape=cylinder3;size=16;boundedLbl=1;">
