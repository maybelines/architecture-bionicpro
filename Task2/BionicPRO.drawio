        <mxCell id="chip" value="&lt;b style=&quot;font-size:18px&quot;&gt;Программа протеза&lt;/b&gt;&lt;br&gt;[Container: C++ / ESP32]&lt;br&gt;&lt;br&gt;Передаёт данные датчиков" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=15;spacing=12;">
          <mxGeometry as="geometry" x="340" y="1090" width="270" height="145" />
        </mxCell>
        <mxCell id="telemetry-db" value="&lt;b style=&quot;font-size:18px&quot;&gt;DB&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL]&lt;br&gt;&lt;br&gt;Телеметрия по протезам&lt;br&gt;и времени события" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=15;spacing=12;shape=cylinder3;size=16;boundedLbl=1;">
          <mxGeometry as="geometry" x="700" y="1090" width="270" height="145" />
        </mxCell>
        <mxCell id="airflow" value="&lt;b style=&quot;font-size:18px&quot;&gt;ETL&lt;/b&gt;&lt;br&gt;[Container: Apache Airflow]&lt;br&gt;&lt;br&gt;Каждый день, 00:00 UTC.&lt;br&gt;Выгрузка источников,&lt;br&gt;объединение и агрегация за сутки" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=15;spacing=12;">
          <mxGeometry as="geometry" x="1110" y="930" width="270" height="180" />
        </mxCell>
        <mxCell id="mart" value="&lt;b&gt;Одна строка витрины&lt;/b&gt;&lt;br&gt;&lt;br&gt;Пользователь + протез + день:&lt;br&gt;число событий и движений,&lt;br&gt;средний отклик и заряд батареи.&lt;br&gt;&lt;br&gt;ORDER BY (user_id, report_date, prosthesis_id, run_id)" parent="1" vertex="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;align=left;spacing=18;">
          <mxGeometry as="geometry" x="1480" y="600" width="400" height="230" />
        </mxCell>
        <mxCell id="publication" value="Airflow отмечает день готовым после полной записи витрины.&lt;br&gt;API читает последнюю успешную версию.&lt;br&gt;Если хотя бы один день не готов — HTTP 409." parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=16;">
          <mxGeometry as="geometry" x="1480" y="980" width="400" height="170" />
        </mxCell>
        <mxCell id="demo" value="В учебном стенде CRM и DB заменены двумя тестовыми базами PostgreSQL.&lt;br&gt;Вызовы стенда идут по HTTP на localhost; внешние соединения — HTTPS." parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;">
